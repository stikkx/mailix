# Maintainer: stikkx (https://github.com/stikkx)
# Mailix: fast, lightweight, IMAP-first desktop mail client.
#
# This is a binary package built from the release tarball: it needs no Rust
# toolchain and no network access beyond the release download. Always take
# this file from the release page, because pkgver and sha256sums are filled in
# per release:
#   curl -fsSLO https://github.com/stikkx/mailix/releases/latest/download/PKGBUILD
#   makepkg -si
#
# The repository version of this file carries a placeholder pkgver, so the
# checkout alone cannot be built - the release asset is the usable one.
#
# Updates without rebuilding: the project also publishes a pacman repository
# (built from this PKGBUILD by the release workflow), so `omarchy update` on
# Omarchy - or `sudo pacman -Syu` on plain Arch - keeps Mailix current. See
# README "Install".

pkgname=mailix
pkgver=0.0.0
pkgrel=1
pkgdesc="Fast, lightweight, IMAP-first desktop mail client"
arch=(x86_64)
url="https://github.com/stikkx/mailix"
license=(MIT)
# a repack of a stripped release binary: no debug package, nothing to strip
options=(!debug)
depends=(wayland libxkbcommon libxkbcommon-x11 libx11 libxcursor libxrandr libxi libxinerama xdg-utils)
optdepends=(
  'gnome-keyring: store mail passwords'
  'keepassxc: alternative keyring provider'
)
source=("$pkgname-$pkgver-x86_64-linux.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -Dm0755 mailix "$pkgdir/usr/bin/mailix"
  install -Dm0644 mailix.desktop "$pkgdir/usr/share/applications/mailix.desktop"
  install -Dm0644 mailix.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/mailix.png"
  install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 Inter-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/Inter-LICENSE.txt"
  install -Dm0644 lucide-LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/lucide-LICENSE.txt"
}
